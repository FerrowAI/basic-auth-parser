{
  "name": "@ferrow/basic-auth-parser",
  "version": "1.0.0",
  "description": "HTTP auth header parsing (Basic, Bearer, Digest) with timing-safe comparison",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
